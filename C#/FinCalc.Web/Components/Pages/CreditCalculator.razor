@page "/credit"
@rendermode InteractiveServer

<h1>Кредитен калкулатор</h1>

<p class="small-muted">
    Калкулаторът използва анюитетна схема. Месечната такса (ако е зададена) се добавя към вноската.
</p>

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <EditForm Model="@Request" OnValidSubmit="OnCalculate">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Главница (лв.)</label>
                <InputNumber class="form-control" @bind-Value="Request.Principal" />
            </div>

            <div class="mb-3">
                <label class="form-label">Годишна лихва (%)</label>
                <InputNumber class="form-control" @bind-Value="Request.AnnualInterestRatePercent" />
            </div>

            <div class="mb-3">
                <label class="form-label">Срок (месеци)</label>
                <InputNumber class="form-control" @bind-Value="Request.TermMonths" />
            </div>

            <div class="mb-3">
                <label class="form-label">Начална дата</label>
                <InputDate class="form-control" @bind-Value="StartDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">Месечна такса (лв.)</label>
                <InputNumber class="form-control" @bind-Value="Request.MonthlyFee" />
            </div>

            <button type="submit" class="btn btn-primary">Изчисли</button>
        </EditForm>
    </div>

    <div class="col-12 col-lg-7">
        @if (Result is null)
        {
            <div class="alert alert-secondary">Въведете параметри и натиснете „Изчисли“.</div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="small text-muted">Месечна вноска</div>
                            <div class="fs-4 fw-semibold">@FormatMoney(Result.MonthlyPayment)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="small text-muted">Общо плащане</div>
                            <div class="fs-4 fw-semibold">@FormatMoney(Result.TotalPaid)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="small text-muted">Общо лихва</div>
                            <div class="fs-4 fw-semibold">@FormatMoney(Result.TotalInterestPaid)</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="card">
                        <div class="card-body">
                            <div class="small text-muted">Общо такси</div>
                            <div class="fs-4 fw-semibold">@FormatMoney(Result.TotalFeesPaid)</div>
                        </div>
                    </div>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">Погасителен план</h2>
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="ShowFullSchedule" id="fullSchedule" />
                    <label class="form-check-label" for="fullSchedule">Покажи всички</label>
                </div>
            </div>

            <div class="table-responsive mt-2" style="max-height: 520px;">
                <table class="table table-sm table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>№</th>
                            <th>Дата</th>
                            <th class="text-end">Нач. салдо</th>
                            <th class="text-end">Вноска</th>
                            <th class="text-end">Главница</th>
                            <th class="text-end">Лихва</th>
                            <th class="text-end">Крайно салдо</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AmortizationRow row in VisibleSchedule)
                        {
                            <tr>
                                <td>@row.PeriodNumber</td>
                                <td>@row.DueDate.ToString("d", CultureInfo.CurrentCulture)</td>
                                <td class="text-end">@FormatMoney(row.BeginningBalance)</td>
                                <td class="text-end">@FormatMoney(row.Payment)</td>
                                <td class="text-end">@FormatMoney(row.PrincipalPaid)</td>
                                <td class="text-end">@FormatMoney(row.InterestPaid)</td>
                                <td class="text-end">@FormatMoney(row.EndingBalance)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
