<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(FinCalc.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(FinCalc.Components.Layout.MainLayout)">
            <h1>Страницата не е намерена</h1>
            <p>Моля, проверете адреса или използвайте менюто.</p>
        </LayoutView>
    </NotFound>
</Router>
