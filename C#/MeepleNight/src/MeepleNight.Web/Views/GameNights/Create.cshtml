@model CreateGameNightRequest
@{
    ViewData["Title"] = "New Game Night";
    var availableGames = ViewBag.AvailableGames as List<GameSummaryDto> ?? new List<GameSummaryDto>();
    var suggestions = ViewBag.Suggestions as List<PlayNextSuggestionDto> ?? new List<PlayNextSuggestionDto>();
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-ink-500 dark:text-ink-400 hover:text-ember-600 dark:hover:text-ember-300 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to my nights
    </a>
</div>

<header class="mb-8">
    <p class="mn-chip mn-chip-ember mb-3">New game night</p>
    <h1 class="mn-page-title">Plan a new night</h1>
    <p class="mt-2 text-ink-500 dark:text-ink-400">Set the date, the place, and a shortlist of games. You can invite friends after creating it.</p>
</header>

<div class="grid gap-6 lg:grid-cols-3">
    <form asp-action="Create" method="post" class="mn-card lg:col-span-2 space-y-5">
        <div asp-validation-summary="ModelOnly" class="rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-700 dark:text-rose-300 text-sm p-3 hidden [&:has(li)]:block"></div>

        <div>
            <label class="mn-label" asp-for="Title">Title</label>
            <input asp-for="Title" class="mn-field" placeholder="e.g. Friday Strategy Night" />
            <span asp-validation-for="Title" class="mn-error"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label class="mn-label" asp-for="ScheduledForUtc">Scheduled for</label>
                <input asp-for="ScheduledForUtc" type="datetime-local" class="mn-field" />
                <span asp-validation-for="ScheduledForUtc" class="mn-error"></span>
            </div>
            <div>
                <label class="mn-label" asp-for="ExpectedPlayerCount">Expected players</label>
                <input asp-for="ExpectedPlayerCount" type="number" class="mn-field" min="2" max="20" />
                <span asp-validation-for="ExpectedPlayerCount" class="mn-error"></span>
            </div>
        </div>

        <div>
            <label class="mn-label" asp-for="Location">Location</label>
            <input asp-for="Location" class="mn-field" placeholder="e.g. Anna's place" />
            <span asp-validation-for="Location" class="mn-error"></span>
        </div>

        <div>
            <label class="mn-label" asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="mn-field" rows="3" placeholder="Anything to share with attendees..."></textarea>
            <span asp-validation-for="Notes" class="mn-error"></span>
        </div>

        <div>
            <label class="mn-label" asp-for="CandidateGameIds">Candidate games (up to 10)</label>
            <select asp-for="CandidateGameIds" class="mn-field" multiple size="6">
                @foreach (GameSummaryDto g in availableGames.Where(g => g.IsActive))
                {
                    <option value="@g.Id">@g.Title (@g.MinPlayers–@g.MaxPlayers players, @g.AverageDurationMinutes min)</option>
                }
            </select>
            <p class="mn-help">Hold Ctrl (or Cmd on Mac) to select multiple.</p>
        </div>

        <div class="flex flex-wrap gap-2 pt-2 border-t border-ink-200 dark:border-ink-800">
            <button type="submit" class="mn-btn mn-btn-primary">Create</button>
            <a asp-action="Index" class="mn-btn mn-btn-ghost">Cancel</a>
        </div>
    </form>

    <aside class="mn-card h-fit">
        <div class="flex items-center gap-2">
            <span class="grid h-9 w-9 place-items-center rounded-xl bg-ember-500/10 text-ember-600 dark:text-ember-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14a5 5 0 1 0-6.18 0c.66.5 1.09 1.27 1.09 2.1V17h4v-.9c0-.83.43-1.6 1.09-2.1z"/></svg>
            </span>
            <h2 class="font-display text-lg font-semibold text-ink-900 dark:text-ink-50">Suggestions</h2>
        </div>
        <p class="mt-2 text-sm text-ink-500 dark:text-ink-400">Based on your past plays.</p>

        @if (suggestions.Any())
        {
            <ul class="mt-4 space-y-3">
                @foreach (PlayNextSuggestionDto s in suggestions)
                {
                    <li class="rounded-lg border border-ink-200 dark:border-ink-800 bg-ink-50/40 dark:bg-ink-900/40 p-3">
                        <div class="flex items-start justify-between gap-2">
                            <strong class="text-ink-900 dark:text-ink-100">@s.Title</strong>
                            <span class="mn-chip mn-chip-ember">@s.Category</span>
                        </div>
                        <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">@s.Reason</p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mt-4 text-sm italic text-ink-500 dark:text-ink-400">No suggestions yet — they appear after you log a few sessions.</p>
        }
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
