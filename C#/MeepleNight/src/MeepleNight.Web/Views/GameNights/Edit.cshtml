@model UpdateGameNightRequest
@{
    ViewData["Title"] = "Edit Game Night";
    var availableGames = ViewBag.AvailableGames as List<GameSummaryDto> ?? new List<GameSummaryDto>();
}

<div class="mb-6">
    <a asp-action="Details" asp-route-id="@Model.Id" class="inline-flex items-center gap-1 text-sm text-ink-500 dark:text-ink-400 hover:text-ember-600 dark:hover:text-ember-300 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to night
    </a>
</div>

<header class="mb-8">
    <p class="mn-chip mn-chip-ember mb-3">Editing</p>
    <h1 class="mn-page-title">Edit Game Night</h1>
</header>

<div class="grid gap-6 lg:grid-cols-3">
    <form asp-action="Edit" method="post" class="mn-card lg:col-span-2 space-y-5">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-700 dark:text-rose-300 text-sm p-3 hidden [&:has(li)]:block"></div>

        <div>
            <label class="mn-label" asp-for="Title">Title</label>
            <input asp-for="Title" class="mn-field" />
            <span asp-validation-for="Title" class="mn-error"></span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label class="mn-label" asp-for="ScheduledForUtc">Scheduled for</label>
                <input asp-for="ScheduledForUtc" type="datetime-local" class="mn-field" />
                <span asp-validation-for="ScheduledForUtc" class="mn-error"></span>
            </div>
            <div>
                <label class="mn-label" asp-for="ExpectedPlayerCount">Expected players</label>
                <input asp-for="ExpectedPlayerCount" type="number" class="mn-field" min="2" max="20" />
                <span asp-validation-for="ExpectedPlayerCount" class="mn-error"></span>
            </div>
        </div>

        <div>
            <label class="mn-label" asp-for="Location">Location</label>
            <input asp-for="Location" class="mn-field" />
            <span asp-validation-for="Location" class="mn-error"></span>
        </div>

        <div>
            <label class="mn-label" asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="mn-field" rows="3"></textarea>
            <span asp-validation-for="Notes" class="mn-error"></span>
        </div>

        <div>
            <label class="mn-label" asp-for="CandidateGameIds">Candidate games</label>
            <select asp-for="CandidateGameIds" class="mn-field" multiple size="6">
                @foreach (GameSummaryDto g in availableGames.Where(g => g.IsActive))
                {
                    <option value="@g.Id">@g.Title</option>
                }
            </select>
            <p class="mn-help">Hold Ctrl (or Cmd on Mac) to select multiple.</p>
        </div>

        <div class="flex flex-wrap gap-2 pt-2 border-t border-ink-200 dark:border-ink-800">
            <button type="submit" class="mn-btn mn-btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="mn-btn mn-btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
