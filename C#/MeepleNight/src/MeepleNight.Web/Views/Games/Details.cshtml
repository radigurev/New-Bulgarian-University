@model GameDetailsDto
@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-6">
    <a asp-action="Index" class="inline-flex items-center gap-1 text-sm text-ink-500 dark:text-ink-400 hover:text-ember-600 dark:hover:text-ember-300 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Back to catalog
    </a>
</div>

<header class="mb-8 flex flex-wrap items-start justify-between gap-4">
    <div>
        <p class="mn-chip mn-chip-ember mb-3">@Model.Category</p>
        <h1 class="mn-page-title">@Model.Title</h1>
    </div>
    @if (!Model.IsActive)
    {
        <span class="mn-chip bg-amber-500/15 text-amber-700 dark:text-amber-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Inactive
        </span>
    }
</header>

<div class="grid gap-5 lg:grid-cols-3">
    <div class="mn-card lg:col-span-2">
        <h2 class="font-display text-lg font-semibold text-ink-900 dark:text-ink-50">About</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-3 text-ink-700 dark:text-ink-300 whitespace-pre-wrap">@Model.Description</p>
        }
        else
        {
            <p class="mt-3 text-ink-500 dark:text-ink-400 italic">No description provided.</p>
        }

        <dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-ink-200 dark:border-ink-800 pt-6">
            <div>
                <dt class="text-xs uppercase tracking-wide text-ink-400">Players</dt>
                <dd class="mt-1 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50">@Model.MinPlayers–@Model.MaxPlayers</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-ink-400">Average duration</dt>
                <dd class="mt-1 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50">@Model.AverageDurationMinutes <span class="text-base font-medium text-ink-500">min</span></dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-wide text-ink-400">Category</dt>
                <dd class="mt-1 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50">@Model.Category</dd>
            </div>
        </dl>
    </div>

    <div class="mn-card">
        <h2 class="font-display text-lg font-semibold text-ink-900 dark:text-ink-50">Activity</h2>
        <div class="mt-4 space-y-4">
            <div>
                <p class="text-xs uppercase tracking-wide text-ink-400">Community plays</p>
                <p class="mt-1 font-display text-3xl font-bold text-ember-600 dark:text-ember-300">@Model.CommunitySessionCount</p>
            </div>
            @if (Model.PersonalSessionCount.HasValue)
            {
                <div class="pt-4 border-t border-ink-200 dark:border-ink-800">
                    <p class="text-xs uppercase tracking-wide text-ink-400">Your plays</p>
                    <p class="mt-1 font-display text-3xl font-bold text-ink-900 dark:text-ink-50">@Model.PersonalSessionCount</p>
                </div>
            }
        </div>
    </div>
</div>
