@model List<GameSummaryDto>
@{
    ViewData["Title"] = "Games";
    GameBrowseQuery query = ViewBag.Query as GameBrowseQuery ?? new GameBrowseQuery();
    string[] sortOptions = new[] { "title", "duration_asc", "duration_desc", "popularity" };
    Dictionary<string, string> sortLabels = new()
    {
        { "title", "Title (A → Z)" },
        { "duration_asc", "Duration (short → long)" },
        { "duration_desc", "Duration (long → short)" },
        { "popularity", "Most played" },
    };
}

<header class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
        <p class="mn-chip mn-chip-ember mb-3">Catalog</p>
        <h1 class="mn-page-title">Game Catalog</h1>
        <p class="mt-2 text-ink-500 dark:text-ink-400">Browse the games available for your next game night.</p>
    </div>
</header>

<form method="get" class="mn-card mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-4">
        <div class="lg:col-span-2">
            <label class="mn-label">Search</label>
            <div class="relative">
                <span class="absolute inset-y-0 left-3 grid place-items-center text-ink-400">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" name="search" value="@query.Search" class="mn-field pl-9" placeholder="Title contains..." />
            </div>
        </div>
        <div>
            <label class="mn-label">Category</label>
            <select name="category" class="mn-field">
                <option value="">All</option>
                @foreach (GameCategory c in Enum.GetValues<GameCategory>())
                {
                    if (query.Category == c) { <option value="@c" selected>@c</option> }
                    else { <option value="@c">@c</option> }
                }
            </select>
        </div>
        <div>
            <label class="mn-label">Players</label>
            <input type="number" name="players" value="@query.PlayerCount" class="mn-field" min="1" max="20" />
        </div>
        <div>
            <label class="mn-label">Max duration (min)</label>
            <input type="number" name="maxDuration" value="@query.MaxDurationMinutes" class="mn-field" min="5" max="720" />
        </div>
        <div>
            <label class="mn-label">Sort by</label>
            <select name="sort" class="mn-field">
                @foreach (string s in sortOptions)
                {
                    if (query.Sort == s) { <option value="@s" selected>@sortLabels[s]</option> }
                    else { <option value="@s">@sortLabels[s]</option> }
                }
            </select>
        </div>
    </div>
    <div class="mt-4 flex items-center gap-2">
        <button type="submit" class="mn-btn mn-btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
            Apply filters
        </button>
        <a asp-action="Index" class="mn-btn mn-btn-ghost">Reset</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="mn-card text-center py-12">
        <div class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-ember-500/10 text-ember-600 dark:text-ember-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <h3 class="font-display text-xl font-semibold">No games match those filters</h3>
        <p class="mt-2 text-ink-500 dark:text-ink-400">Try widening your search.</p>
        <a asp-action="Index" class="mt-5 mn-btn mn-btn-secondary inline-flex">Clear filters</a>
    </div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        @foreach (GameSummaryDto game in Model)
        {
            <a asp-action="Details" asp-route-id="@game.Id" class="mn-card mn-card-hover block group">
                <div class="flex items-start justify-between gap-3">
                    <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-ink-50 group-hover:text-ember-600 dark:group-hover:text-ember-300 transition-colors">
                        @game.Title
                    </h3>
                    <span class="mn-chip mn-chip-ember shrink-0">@game.Category</span>
                </div>
                <div class="mt-5 flex flex-wrap gap-4 text-sm text-ink-500 dark:text-ink-400">
                    <span class="inline-flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-ink-400"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        @game.MinPlayers–@game.MaxPlayers players
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-ink-400"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        @game.AverageDurationMinutes min
                    </span>
                </div>
            </a>
        }
    </div>
}
