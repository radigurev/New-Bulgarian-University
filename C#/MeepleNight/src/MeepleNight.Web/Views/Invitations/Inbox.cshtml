@model InboxPageViewModel
@{
    ViewData["Title"] = "Inbox";
}

<header class="mb-8">
    <p class="mn-chip mn-chip-ember mb-3">Invitations</p>
    <h1 class="mn-page-title">Inbox</h1>
    <p class="mt-2 text-ink-500 dark:text-ink-400">Pending invites, upcoming nights you've accepted, and past activity.</p>
</header>

<section class="mb-10">
    <div class="mb-4 flex items-center gap-2">
        <h2 class="font-display text-xl font-semibold text-ink-900 dark:text-ink-50">Action needed</h2>
        <span class="mn-chip mn-chip-ember">@Model.Pending.Count</span>
    </div>

    @if (!Model.Pending.Any())
    {
        <div class="mn-card text-center py-10">
            <div class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-2xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-300">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <p class="text-ink-500 dark:text-ink-400">All caught up — no pending invitations.</p>
        </div>
    }
    else
    {
        <div class="grid gap-4 md:grid-cols-2">
            @foreach (InboxInvitationDto inv in Model.Pending)
            {
                <div class="mn-card mn-card-hover flex flex-col">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <a asp-controller="GameNights" asp-action="Details" asp-route-id="@inv.GameNightId"
                               class="block font-display text-lg font-semibold text-ink-900 dark:text-ink-50 hover:text-ember-600 dark:hover:text-ember-300 truncate">
                                @inv.GameNightTitle
                            </a>
                            <p class="mt-1 text-sm text-ink-500 dark:text-ink-400">
                                Hosted by <span class="font-medium text-ink-700 dark:text-ink-200">@inv.HostDisplayName</span>
                            </p>
                        </div>
                        <span class="mn-chip bg-amber-500/15 text-amber-700 dark:text-amber-300 shrink-0">Pending</span>
                    </div>

                    <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
                        <div>
                            <dt class="text-xs uppercase tracking-wide text-ink-400">When</dt>
                            <dd class="mt-0.5 text-ink-900 dark:text-ink-100">@inv.ScheduledForUtc.ToLocalTime().ToString("ddd, MMM d · HH:mm")</dd>
                        </div>
                        <div>
                            <dt class="text-xs uppercase tracking-wide text-ink-400">Where</dt>
                            <dd class="mt-0.5 text-ink-900 dark:text-ink-100 truncate">@inv.Location</dd>
                        </div>
                    </dl>

                    <div class="mt-5 pt-4 border-t border-ink-200 dark:border-ink-800 flex flex-wrap items-center gap-2">
                        <form asp-action="Respond" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="InvitationId" value="@inv.InvitationId" />
                            <input type="hidden" name="Response" value="@InvitationStatus.Accepted" />
                            <button type="submit" class="mn-btn mn-btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="20 6 9 17 4 12"/></svg>
                                Accept
                            </button>
                        </form>
                        <form asp-action="Respond" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="InvitationId" value="@inv.InvitationId" />
                            <input type="hidden" name="Response" value="@InvitationStatus.Declined" />
                            <button type="submit" class="mn-btn mn-btn-ghost">Decline</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="mb-10">
    <div class="mb-4 flex items-center gap-2">
        <h2 class="font-display text-xl font-semibold text-ink-900 dark:text-ink-50">Upcoming</h2>
        <span class="mn-chip">@Model.Upcoming.Count</span>
    </div>
    @if (!Model.Upcoming.Any())
    {
        <p class="text-ink-500 dark:text-ink-400 italic">No upcoming nights.</p>
    }
    else
    {
        <ul class="mn-card !p-0 divide-y divide-ink-200 dark:divide-ink-800 overflow-hidden">
            @foreach (InboxInvitationDto inv in Model.Upcoming)
            {
                <li class="px-5 py-4 flex items-center justify-between gap-3 hover:bg-ink-50 dark:hover:bg-ink-900/60 transition-colors">
                    <div class="min-w-0">
                        <a asp-controller="GameNights" asp-action="Details" asp-route-id="@inv.GameNightId"
                           class="font-semibold text-ink-900 dark:text-ink-100 hover:text-ember-600 dark:hover:text-ember-300">@inv.GameNightTitle</a>
                        <p class="mt-0.5 text-sm text-ink-500 dark:text-ink-400 truncate">@inv.ScheduledForUtc.ToLocalTime().ToString("ddd, MMM d · HH:mm") · @inv.Location</p>
                    </div>
                    <span class="mn-chip bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 shrink-0">Accepted</span>
                </li>
            }
        </ul>
    }
</section>

<section>
    <div class="mb-4 flex items-center gap-2">
        <h2 class="font-display text-xl font-semibold text-ink-900 dark:text-ink-50">History</h2>
        <span class="mn-chip">@Model.History.Count</span>
    </div>
    @if (!Model.History.Any())
    {
        <p class="text-ink-500 dark:text-ink-400 italic">No history yet.</p>
    }
    else
    {
        <ul class="mn-card !p-0 divide-y divide-ink-200 dark:divide-ink-800 overflow-hidden">
            @foreach (InboxInvitationDto inv in Model.History)
            {
                <li class="px-5 py-4 flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <p class="font-medium text-ink-700 dark:text-ink-200 truncate">@inv.GameNightTitle</p>
                        <p class="mt-0.5 text-sm text-ink-500 dark:text-ink-400">@inv.ScheduledForUtc.ToLocalTime().ToString("yyyy-MM-dd · HH:mm")</p>
                    </div>
                    <span class="mn-chip shrink-0">@inv.Status</span>
                </li>
            }
        </ul>
    }
</section>
