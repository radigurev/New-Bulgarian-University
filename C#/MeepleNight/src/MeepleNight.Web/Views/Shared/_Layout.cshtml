@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject MeepleNight.Services.IInvitationService InvitationService
@{
    int pendingInvitationCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        try { pendingInvitationCount = await InvitationService.GetPendingCountAsync(); }
        catch { pendingInvitationCount = 0; }
    }
    bool isAdmin = User.IsInRole("Admin");
    bool isSignedIn = SignInManager.IsSignedIn(User);
}
<!DOCTYPE html>
<html lang="en"
      x-data
      x-init="$store.theme.init()"
      :class="$store.theme.dark ? 'dark' : ''">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MeepleNight</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                        display: ['Fraunces', 'ui-serif', 'Georgia', 'serif'],
                    },
                    colors: {
                        ink: {
                            50:  '#f7f7f8',
                            100: '#eeeef1',
                            200: '#d8d9df',
                            300: '#b6b8c2',
                            400: '#8a8c99',
                            500: '#6b6d7a',
                            600: '#52535d',
                            700: '#3f4049',
                            800: '#2a2b32',
                            850: '#1f2027',
                            900: '#161720',
                            950: '#0d0e15',
                        },
                        ember: {
                            50:  '#fff8eb',
                            100: '#ffeac6',
                            200: '#ffd388',
                            300: '#ffb84a',
                            400: '#ffa01f',
                            500: '#f58308',
                            600: '#d96202',
                            700: '#b44506',
                            800: '#91370c',
                            900: '#772f0d',
                        },
                    },
                    boxShadow: {
                        soft: '0 1px 2px rgba(0,0,0,.04), 0 6px 24px -8px rgba(0,0,0,.18)',
                        glow: '0 0 0 1px rgba(255,184,74,.25), 0 8px 32px -8px rgba(255,160,31,.35)',
                    },
                    borderRadius: {
                        xl2: '1.25rem',
                    }
                }
            }
        };
    </script>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        document.addEventListener('alpine:init', () => {
            Alpine.store('theme', {
                dark: true,
                init() {
                    const stored = localStorage.getItem('mn-theme');
                    this.dark = stored ? stored === 'dark' : true;
                },
                toggle() {
                    this.dark = !this.dark;
                    localStorage.setItem('mn-theme', this.dark ? 'dark' : 'light');
                }
            });
        });
    </script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="font-sans antialiased min-h-screen bg-ink-50 text-ink-900 dark:bg-ink-950 dark:text-ink-100 transition-colors">

    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-40 -left-32 h-[34rem] w-[34rem] rounded-full bg-ember-500/10 blur-3xl"></div>
        <div class="absolute top-1/3 -right-40 h-[28rem] w-[28rem] rounded-full bg-ember-300/10 blur-3xl"></div>
    </div>

    <header x-data="{ mobile: false }"
            class="sticky top-0 z-40 backdrop-blur bg-white/70 dark:bg-ink-950/70 border-b border-ink-200/60 dark:border-ink-800/60">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex h-16 items-center justify-between gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Index"
                   class="flex items-center gap-2 font-display text-xl font-bold tracking-tight">
                    <span class="grid h-9 w-9 place-items-center rounded-xl bg-gradient-to-br from-ember-400 to-ember-600 text-ink-950 shadow-glow">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                            <rect x="3" y="3" width="18" height="18" rx="4" />
                            <circle cx="8" cy="8" r="1.2" fill="currentColor" />
                            <circle cx="16" cy="8" r="1.2" fill="currentColor" />
                            <circle cx="12" cy="12" r="1.2" fill="currentColor" />
                            <circle cx="8" cy="16" r="1.2" fill="currentColor" />
                            <circle cx="16" cy="16" r="1.2" fill="currentColor" />
                        </svg>
                    </span>
                    <span>MeepleNight</span>
                </a>

                <nav class="hidden md:flex items-center gap-1">
                    <a asp-area="" asp-controller="Games" asp-action="Index" class="mn-nav-link">Games</a>
                    @if (isSignedIn)
                    {
                        <a asp-area="" asp-controller="GameNights" asp-action="Index" class="mn-nav-link">My Nights</a>
                        <a asp-area="" asp-controller="Invitations" asp-action="Inbox" class="mn-nav-link relative">
                            Inbox
                            @if (pendingInvitationCount > 0)
                            {
                                <span class="ml-1 inline-flex items-center justify-center rounded-full bg-ember-500 px-2 py-0.5 text-[11px] font-semibold leading-none text-ink-950">
                                    @pendingInvitationCount
                                </span>
                            }
                        </a>
                        <a asp-area="" asp-controller="Statistics" asp-action="Index" class="mn-nav-link">Statistics</a>
                    }
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Games" asp-action="Index"
                           class="mn-nav-link text-ember-600 dark:text-ember-300">Admin · Games</a>
                    }
                </nav>

                <div class="flex items-center gap-2">
                    <button type="button"
                            @@click="$store.theme.toggle()"
                            aria-label="Toggle theme"
                            class="hidden sm:grid h-9 w-9 place-items-center rounded-lg text-ink-500 hover:text-ink-900 hover:bg-ink-100 dark:hover:text-ink-100 dark:hover:bg-ink-800 transition">
                        <svg x-show="!$store.theme.dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
                        <svg x-show="$store.theme.dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    </button>

                    <partial name="_LoginPartial" />

                    <button type="button"
                            @@click="mobile = !mobile"
                            class="md:hidden grid h-9 w-9 place-items-center rounded-lg text-ink-500 hover:text-ink-900 hover:bg-ink-100 dark:hover:text-ink-100 dark:hover:bg-ink-800 transition"
                            aria-label="Toggle menu">
                        <svg x-show="!mobile" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                        <svg x-show="mobile" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>

            <nav x-show="mobile" x-transition x-cloak class="md:hidden pb-4 flex flex-col gap-1">
                <a asp-area="" asp-controller="Games" asp-action="Index" class="mn-nav-link-mobile">Games</a>
                @if (isSignedIn)
                {
                    <a asp-area="" asp-controller="GameNights" asp-action="Index" class="mn-nav-link-mobile">My Nights</a>
                    <a asp-area="" asp-controller="Invitations" asp-action="Inbox" class="mn-nav-link-mobile">
                        Inbox
                        @if (pendingInvitationCount > 0)
                        {
                            <span class="ml-2 inline-flex items-center justify-center rounded-full bg-ember-500 px-2 py-0.5 text-[11px] font-semibold leading-none text-ink-950">@pendingInvitationCount</span>
                        }
                    </a>
                    <a asp-area="" asp-controller="Statistics" asp-action="Index" class="mn-nav-link-mobile">Statistics</a>
                }
                @if (isAdmin)
                {
                    <a asp-area="Admin" asp-controller="Games" asp-action="Index" class="mn-nav-link-mobile text-ember-600 dark:text-ember-300">Admin · Games</a>
                }
            </nav>
        </div>
    </header>

    <main role="main" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        @if (TempData["Success"] != null)
        {
            <div x-data="{ show: true }" x-show="show" x-transition.opacity
                 class="mb-6 flex items-start gap-3 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-emerald-800 dark:text-emerald-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 mt-0.5 shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div class="flex-1">@TempData["Success"]</div>
                <button type="button" @@click="show = false" class="text-emerald-700/70 hover:text-emerald-900 dark:text-emerald-300/70 dark:hover:text-emerald-100" aria-label="Dismiss">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div x-data="{ show: true }" x-show="show" x-transition.opacity
                 class="mb-6 flex items-start gap-3 rounded-xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-rose-800 dark:text-rose-200">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <div class="flex-1">@TempData["Error"]</div>
                <button type="button" @@click="show = false" class="text-rose-700/70 hover:text-rose-900 dark:text-rose-300/70 dark:hover:text-rose-100" aria-label="Dismiss">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="mt-16 border-t border-ink-200/60 dark:border-ink-800/60">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-ink-500 dark:text-ink-400">
            <div class="flex items-center gap-2">
                <span class="font-display font-semibold text-ink-700 dark:text-ink-200">MeepleNight</span>
                <span aria-hidden="true">·</span>
                <span>&copy; @DateTime.Now.Year</span>
            </div>
            <div class="flex items-center gap-4">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-ink-900 dark:hover:text-ink-100 transition">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
