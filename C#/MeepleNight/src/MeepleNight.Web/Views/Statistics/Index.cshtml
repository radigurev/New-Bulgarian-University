@model StatisticsDashboardDto
@{
    ViewData["Title"] = "Statistics";
    int maxMonth = Model.HasData && Model.ActivityByMonth.Any() ? Math.Max(1, Model.ActivityByMonth.Max(m => m.SessionCount)) : 1;
}

<header class="mb-8">
    <p class="mn-chip mn-chip-ember mb-3">Your numbers</p>
    <h1 class="mn-page-title">Statistics</h1>
    <p class="mt-2 text-ink-500 dark:text-ink-400">Track your record, your favorite games, and how often you play.</p>
</header>

@if (!Model.HasData)
{
    <div class="mn-card text-center py-12">
        <div class="mx-auto mb-4 grid h-12 w-12 place-items-center rounded-2xl bg-ember-500/10 text-ember-600 dark:text-ember-300">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </div>
        <h3 class="font-display text-xl font-semibold">No data yet</h3>
        <p class="mt-2 text-ink-500 dark:text-ink-400">Log your first session to see stats here.</p>
        <a asp-controller="GameNights" asp-action="Index" class="mt-5 mn-btn mn-btn-primary inline-flex">Open my game nights</a>
    </div>
    return;
}

<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Sessions played</p>
        <p class="mt-2 font-display text-4xl font-bold text-ink-900 dark:text-ink-50">@Model.TotalSessionsPlayed</p>
    </div>
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Game nights</p>
        <p class="mt-2 font-display text-4xl font-bold text-ink-900 dark:text-ink-50">@Model.TotalGameNightsAttended</p>
    </div>
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Win rate</p>
        <p class="mt-2 font-display text-4xl font-bold text-ember-600 dark:text-ember-300">@Model.WinRatePercent.ToString("0.0")<span class="text-xl text-ink-400">%</span></p>
    </div>
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Frequent opponent</p>
        <p class="mt-2 font-display text-xl font-semibold text-ink-900 dark:text-ink-50 truncate">@(Model.FrequentOpponentDisplayName ?? "—")</p>
    </div>
</section>

<section class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-10">
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Most-played game</p>
        <p class="mt-2 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50">@(Model.MostPlayedGameTitle ?? "—")</p>
    </div>
    <div class="mn-card">
        <p class="text-xs uppercase tracking-wide text-ink-400">Best record (≥ 3 plays)</p>
        @if (Model.BestRecordGameTitle != null)
        {
            <p class="mt-2 font-display text-2xl font-semibold text-ink-900 dark:text-ink-50">
                @Model.BestRecordGameTitle
                <span class="ml-2 text-base font-medium text-ember-600 dark:text-ember-300">@Model.BestRecordWinRate?.ToString("0.0") %</span>
            </p>
        }
        else
        {
            <p class="mt-2 font-display text-2xl font-semibold text-ink-500 dark:text-ink-400">Need more plays</p>
        }
    </div>
</section>

<section class="mb-10">
    <h2 class="font-display text-xl font-semibold text-ink-900 dark:text-ink-50 mb-4">Per-game breakdown</h2>
    <div class="mn-card !p-0 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-ink-100/60 dark:bg-ink-900/60 text-left text-xs uppercase tracking-wide text-ink-500 dark:text-ink-400">
                    <tr>
                        <th class="px-5 py-3 font-semibold">Game</th>
                        <th class="px-5 py-3 font-semibold text-right">Plays</th>
                        <th class="px-5 py-3 font-semibold text-right">Wins</th>
                        <th class="px-5 py-3 font-semibold text-right">Win rate</th>
                        <th class="px-5 py-3 font-semibold">Last played</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ink-200 dark:divide-ink-800">
                    @foreach (GameStatsRowDto r in Model.PerGameBreakdown)
                    {
                        <tr class="hover:bg-ink-50 dark:hover:bg-ink-900/60 transition-colors">
                            <td class="px-5 py-3 font-medium text-ink-900 dark:text-ink-100">@r.GameTitle</td>
                            <td class="px-5 py-3 text-right text-ink-600 dark:text-ink-300">@r.Plays</td>
                            <td class="px-5 py-3 text-right text-ink-600 dark:text-ink-300">@r.Wins</td>
                            <td class="px-5 py-3 text-right font-semibold text-ember-600 dark:text-ember-300">@r.WinRatePercent.ToString("0.0") %</td>
                            <td class="px-5 py-3 text-ink-600 dark:text-ink-300">@r.LastPlayedAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section>
    <h2 class="font-display text-xl font-semibold text-ink-900 dark:text-ink-50 mb-4">Activity — last 12 months</h2>
    <div class="mn-card">
        <div class="grid grid-cols-12 gap-2 items-end h-40">
            @foreach (var month in Model.ActivityByMonth)
            {
                int pct = (int)(((double)month.SessionCount / maxMonth) * 100);
                if (month.SessionCount == 0) { pct = 2; }
                <div class="flex flex-col items-center justify-end h-full">
                    <span class="text-xs font-semibold text-ink-700 dark:text-ink-200 mb-1">@month.SessionCount</span>
                    <div class="w-full rounded-md bg-gradient-to-t from-ember-600 to-ember-400 transition-all"
                         style="height: @(pct)%; min-height: 4px;"
                         title="@month.Label: @month.SessionCount sessions"></div>
                </div>
            }
        </div>
        <div class="mt-2 grid grid-cols-12 gap-2">
            @foreach (var month in Model.ActivityByMonth)
            {
                <div class="text-center text-[10px] uppercase tracking-wide text-ink-400">@month.Label</div>
            }
        </div>
    </div>
</section>
