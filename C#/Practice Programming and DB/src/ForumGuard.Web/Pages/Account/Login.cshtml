@page
@model ForumGuard.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="page">
    <div class="page-head">
        <h1>Sign in</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    <form class="form-card" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div class="form-row">
            <label asp-for="Input.Email"></label>
            <input class="form-control" asp-for="Input.Email" autocomplete="username" />
            <span class="field-error" asp-validation-for="Input.Email"></span>
        </div>

        <div class="form-row">
            <label asp-for="Input.Password"></label>
            <input class="form-control" asp-for="Input.Password" autocomplete="current-password" />
            <span class="field-error" asp-validation-for="Input.Password"></span>
        </div>

        <div class="form-row">
            <label class="muted">
                <input type="checkbox" asp-for="Input.RememberMe" /> Remember me
            </label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Sign in</button>
            <a class="muted" asp-page="/Account/Register">Create an account</a>
        </div>
    </form>
</div>
