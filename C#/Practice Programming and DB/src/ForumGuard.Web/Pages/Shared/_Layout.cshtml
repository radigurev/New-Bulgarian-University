@using ForumGuard.Domain.Authorization
@using ForumGuard.Web.Authorization
@using ForumGuard.Web.Presentation
@{
    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    bool isAdministrator = User.IsInRole(ForumRoles.Administrator);
    bool isModerator = User.IsInRole(ForumRoles.Moderator);
    string activePage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string IsActive(string page) => activePage.StartsWith(page, StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ForumGuard</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav-bar" aria-label="Primary">
            <a class="brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true"></span>ForumGuard</a>
            <ul class="nav-tabs">
                <li><a class="nav-tab @IsActive("/Index")" asp-page="/Index">Threads</a></li>
                @if (isModerator)
                {
                    <li><a class="nav-tab @IsActive("/Moderation")" asp-page="/Moderation/Queue">Queue</a></li>
                }
                @if (isAdministrator)
                {
                    <li><a class="nav-tab @IsActive("/Admin")" asp-page="/Admin/Users">Admin</a></li>
                }
                @if (isAuthenticated)
                {
                    <li><a class="nav-tab @IsActive("/Dashboard")" asp-page="/Dashboard">Dashboard</a></li>
                }
            </ul>
            <span class="nav-spacer"></span>
            <div class="nav-session">
                @if (isAuthenticated)
                {
                    <span class="badge role-badge @BadgePresenter.RoleClass(isAdministrator, isModerator)">@BadgePresenter.RoleLabel(isAdministrator, isModerator)</span>
                    <span class="nav-user">@User.Identity!.Name</span>
                    <form class="inline-form" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="btn-link">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="nav-tab" asp-page="/Account/Login">Sign in</a>
                    <a class="btn btn-primary btn-sm" asp-page="/Account/Register">Register</a>
                }
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="page">
            ForumGuard — comments are screened automatically before they appear.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
